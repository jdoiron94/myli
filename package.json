{
  "name": "myli",
  "version": "0.14.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel dev",
    "dev:all": "node scripts/dev-all.ts",
    "db:generate": "pnpm --filter @myli/api db:generate",
    "seed": "pnpm --filter @myli/api seed",
    "reindex": "pnpm --filter @myli/api reindex",
    "format": "biome check --write",
    "format:check": "biome check",
    "lint": "eslint . --max-warnings=0",
    "openapi:generate": "pnpm --filter @myli/api openapi:generate && pnpm --filter @myli/web openapi:generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @myli/e2e test",
    "test:containers": "pnpm --filter @myli/api test:containers && pnpm --filter @myli/e2e test:containers",
    "typecheck": "tsc --noEmit && pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@eslint/js": "10.0.1",
    "@types/node": "catalog:",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "jiti": "2.7.0",
    "lefthook": "2.2.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
