# Configuration for myli. Copy this file to .env and change what you need.
# Every variable is shown with its default value. An empty value counts as unset.
# Variables marked "Required" have no default, and the API won't start until they're set.
# Secrets can be read from a file instead, such as a Docker secret: set the variable ending in
# _FILE to the file's path, and leave the secret itself empty. One trailing newline is ignored.
#
# Docker Compose (compose.yaml) reads this file too, from the same directory. With Compose:
# - NODE_ENV, HOST, PORT, DATABASE_PATH, MEILI_URL and TRUSTED_PROXIES are set for you, and the
#   values here are ignored.
# - Leave the _FILE variables empty: compose.yaml hands the secrets to the containers as files.
# - Keep ADMIN_PASSWORD and SMTP_PASSWORD listed, even empty: Compose won't start without them.
# - The last section is for Compose alone.

# Runtime mode: development, test or production.
NODE_ENV=production

# Address and port the API listens on.
HOST=0.0.0.0
PORT=3000

# Minimum log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# SQLite database file, relative to the API's working directory. Created on first start.
# Keep it on a persistent volume: it holds all of the instance's data.
DATABASE_PATH=./data/myli.db

# Required. The address people open myli at, as an origin with no path,
# e.g. https://myli.example or, for local development, http://localhost:5173.
# With Compose, it must be https://, which Caddy serves.
# Sign-in only accepts requests from this origin, and emailed links point here.
PUBLIC_URL=

# Required. At least 32 characters. Signs session cookies; changing it signs everyone out.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_SECRET_FILE=

# Meilisearch, the search service. myli works without it, except search, and keeps trying to
# reach it. Search is never reached from the browser: only the API talks to it.
MEILI_URL=http://localhost:7700
# Required. Meilisearch's master key, at least 16 characters: the same value Meilisearch is started
# with. The API uses it only at startup, to create its own key limited to what it needs.
# Generate one with: openssl rand -base64 32
MEILI_MASTER_KEY=
MEILI_MASTER_KEY_FILE=

# Optional. The reverse proxies allowed to say who the client is, in X-Forwarded-For: addresses
# or CIDR ranges, comma-separated, e.g. 172.18.0.2 or 172.18.0.0/16. Anyone else's
# X-Forwarded-For is ignored, and the client is the address the connection came from. Leave it
# empty unless the API is only reachable through these proxies.
TRUSTED_PROXIES=

# Days an invitation link works before the admin has to send a new one. 1 to 90.
INVITATION_TTL_DAYS=7

# Optional. Creates the first admin at startup, if no user exists yet, for installs where no one
# opens the setup screen. Set all three or none. Users who already exist are never changed.
# The password needs 15 to 128 characters, with a lowercase letter, an uppercase letter, a number
# and a special character. Empty ADMIN_PASSWORD once the admin exists.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_FILE=

# Optional. Email, such as invitations. Off unless SMTP_HOST is set; without email, admins copy
# invitation links and share them however they like.
# The SMTP server's host name or IP address.
SMTP_HOST=
# Default: 587 for starttls, 465 for tls, 25 for none.
SMTP_PORT=
# How the connection is encrypted:
#   starttls  connects, then upgrades to TLS; refuses to send if the server can't (port 587)
#   tls       TLS from the first byte (port 465)
#   none      no encryption, for Mailpit or a relay on the same machine. A login, if set, is sent
#             unencrypted.
# Server certificates are always verified.
SMTP_SECURITY=starttls
# The login, if the server needs one. Set both or neither.
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=
# Required when SMTP_HOST is set. The sender: an address, optionally with a name,
# e.g. myli <myli@example.com>
SMTP_FROM=

# Docker Compose only (compose.yaml). The API doesn't read these.
# Where myli's images come from: a registry, ending in a slash, like registry.example.com/myli/,
# and the version to run. With no registry, they're the images built here by
# `docker compose up --build`.
MYLI_IMAGE_PREFIX=
MYLI_VERSION=latest
# The host's ports for HTTP, which only redirects, and HTTPS. MYLI_HTTPS_PORT must be PUBLIC_URL's
# port: 443, unless PUBLIC_URL names another.
MYLI_HTTP_PORT=80
MYLI_HTTPS_PORT=443
# The network Caddy and the API share: the API trusts what addresses in it say about who the client
# is. Change it if it clashes with a network on the host.
MYLI_PROXY_SUBNET=10.89.0.0/29
