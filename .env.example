# Configuration for myli. Copy this file to .env and change what you need.
# Every variable is shown with its default value. An empty value counts as unset.
# Variables marked "Required" have no default, and the API won't start until they're set.

# Runtime mode: development, test or production.
NODE_ENV=production

# Address and port the API listens on.
HOST=0.0.0.0
PORT=3000

# Minimum log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# SQLite database file, relative to the API's working directory. Created on first start.
# Keep it on a persistent volume: it holds all of the instance's data.
DATABASE_PATH=./data/myli.db

# Required. The address people open myli at, as an origin with no path,
# e.g. https://myli.example or, for local development, http://localhost:5173.
# Sign-in only accepts requests from this origin, and emailed links point here.
PUBLIC_URL=

# Required. At least 32 characters. Signs session cookies; changing it signs everyone out.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional. Creates the first admin at startup, if no user exists yet, for installs where no one
# opens the setup screen. Set all three or none. Users who already exist are never changed.
# The password needs 15 to 128 characters, with a lowercase letter, an uppercase letter, a number
# and a special character. Remove ADMIN_PASSWORD from here once the admin exists.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
