{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    // Not used by vite.config.ts: the shadcn-vue CLI reads the alias from here (see components.json).
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["*.ts", "scripts"]
}
