{
  "name": "@myli/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --env-file-if-exists=../../.env src/main.ts | pino-pretty",
    "start": "node src/main.ts",
    "seed": "node --env-file-if-exists=../../.env src/seed-demo.ts",
    "reindex": "node --env-file-if-exists=../../.env src/reindex-search.ts",
    "db:generate": "drizzle-kit generate",
    "openapi:generate": "node scripts/generate-openapi.ts",
    "test:containers": "vitest run --config vitest.containers.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@hono/zod-openapi": "1.6.3",
    "@myli/shared": "workspace:*",
    "better-auth": "catalog:",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "meilisearch": "0.62.0",
    "nodemailer": "10.3.1",
    "pino": "10.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "catalog:",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "smtp-server": "3.21.3",
    "testcontainers": "12.2.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  }
}
