{
  "openapi": "3.1.0",
  "info": {
    "title": "myli API",
    "version": "v1",
    "description": "REST API of a self-hosted myli instance. Errors use RFC 9457 problem details."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "schemas": {
      "SetupStatus": {
        "type": "object",
        "properties": {
          "needed": {
            "type": "boolean",
            "description": "True until the first admin exists."
          }
        },
        "required": [
          "needed"
        ]
      },
      "ValidationProblem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "/problems/validation-error"
            ]
          },
          "title": {
            "type": "string",
            "description": "Short summary of the problem type."
          },
          "status": {
            "type": "number",
            "enum": [
              422
            ]
          },
          "detail": {
            "type": "string",
            "description": "Explanation of this occurrence, written for the client. Never contains internals."
          },
          "requestId": {
            "type": "string",
            "description": "Matches the `X-Request-Id` response header and the server log lines for this request."
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "in": {
                  "type": "string",
                  "enum": [
                    "body",
                    "query",
                    "path",
                    "header",
                    "cookie"
                  ],
                  "description": "Which part of the request the field is in."
                },
                "pointer": {
                  "type": "string",
                  "description": "RFC 6901 JSON Pointer to the field within that part, e.g. `#/tags/0`."
                },
                "detail": {
                  "type": "string",
                  "description": "What is wrong with the field."
                }
              },
              "required": [
                "in",
                "pointer",
                "detail"
              ]
            },
            "minItems": 1,
            "description": "One entry per invalid field."
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "errors"
        ],
        "description": "A request that failed schema validation."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Identifies the problem type. `about:blank` means the status code says everything, and `title` is then the standard status text."
          },
          "title": {
            "type": "string",
            "description": "Short summary of the problem type."
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599,
            "description": "The HTTP status code."
          },
          "detail": {
            "type": "string",
            "description": "Explanation of this occurrence, written for the client. Never contains internals."
          },
          "requestId": {
            "type": "string",
            "description": "Matches the `X-Request-Id` response header and the server log lines for this request."
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "description": "RFC 9457 problem details."
      },
      "SetupResult": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "user"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "admin",
          "editor",
          "viewer"
        ]
      },
      "SetupRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "$ref": "#/components/schemas/Password"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "Password": {
        "type": "string",
        "minLength": 15,
        "maxLength": 128,
        "description": "15 to 128 characters, with a lowercase letter, an uppercase letter, a number and a special character (anything but a letter or a number, a space included)."
      },
      "AuditEventList": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            },
            "description": "Newest first."
          },
          "nextBefore": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "Pass as `before` to get the next page. `null` on the last page."
          }
        },
        "required": [
          "events",
          "nextBefore"
        ]
      },
      "AuditEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "action": {
            "type": "string",
            "enum": [
              "setup.completed",
              "invitation.created",
              "invitation.resent",
              "invitation.revoked",
              "invitation.accepted",
              "user.role_changed",
              "user.deactivated",
              "user.reactivated",
              "sign_in.succeeded",
              "sign_in.failed",
              "sign_out.succeeded",
              "recipe.deleted",
              "recipe.restored",
              "recipe.purged",
              "revision.restored",
              "public_link.created",
              "public_link.revoked",
              "instance.exported"
            ]
          },
          "actor": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "description": "Who did it. `null` when nobody was signed in, as for a failed sign-in."
          },
          "target": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "invitation",
                  "user",
                  "recipe"
                ]
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "description": "What it was done to, if anything."
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {},
            "description": "Details that depend on the action, such as the email a failed sign-in tried."
          },
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "userAgent": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "action",
          "actor",
          "target",
          "metadata",
          "ip",
          "userAgent",
          "createdAt"
        ]
      },
      "InvitationList": {
        "type": "object",
        "properties": {
          "invitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Invitation"
            },
            "description": "Open invitations, newest first."
          }
        },
        "required": [
          "invitations"
        ]
      },
      "Invitation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "editor",
              "viewer"
            ],
            "description": "The role the invitee gets on accepting."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "expired"
            ],
            "description": "`pending`: the link works. `expired`: it no longer does; resend or revoke it."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the link stops working."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "status",
          "expiresAt",
          "createdAt"
        ]
      },
      "InvitationWithLink": {
        "type": "object",
        "properties": {
          "invitation": {
            "$ref": "#/components/schemas/Invitation"
          },
          "link": {
            "type": "string",
            "format": "uri",
            "description": "The link to share with the invitee. Present when myli does not email it itself. It is shown only once: myli stores only a hash of the token in it."
          }
        },
        "required": [
          "invitation"
        ]
      },
      "CreateInvitationRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "InvitationDetails": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "The new account gets this email address."
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "email",
          "role",
          "expiresAt"
        ]
      },
      "InvitationLookupRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "token"
        ]
      },
      "AcceptInvitationResult": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "user"
        ]
      },
      "AcceptInvitationRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "password": {
            "$ref": "#/components/schemas/Password"
          }
        },
        "required": [
          "token",
          "name",
          "password"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/setup": {
      "get": {
        "tags": [
          "Setup"
        ],
        "summary": "Whether first-run setup is needed",
        "description": "Public. True until the first admin exists, so the web app knows to show setup.",
        "responses": {
          "200": {
            "description": "Whether setup is needed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          },
          "422": {
            "description": "The request failed validation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          },
          "default": {
            "description": "Any other error, as RFC 9457 problem details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Setup"
        ],
        "summary": "Create the first admin",
        "description": "Public, and only works while no user exists. The new admin then signs in with the same email and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The first admin was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupResult"
                }
              }
            }
          },
          "409": {
            "description": "Setup is already complete, or another setup is in progress.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "The request failed validation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          },
          "default": {
            "description": "Any other error, as RFC 9457 problem details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/audit-events": {
      "get": {
        "tags": [
          "Audit log"
        ],
        "summary": "List audit events",
        "description": "Admins only. Newest first, a page at a time.",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "Only events older than this ID: the `nextBefore` of the previous page."
            },
            "required": false,
            "description": "Only events older than this ID: the `nextBefore` of the previous page.",
            "name": "before",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "setup.completed",
                "invitation.created",
                "invitation.resent",
                "invitation.revoked",
                "invitation.accepted",
                "user.role_changed",
                "user.deactivated",
                "user.reactivated",
                "sign_in.succeeded",
                "sign_in.failed",
                "sign_out.succeeded",
                "recipe.deleted",
                "recipe.restored",
                "recipe.purged",
                "revision.restored",
                "public_link.created",
                "public_link.revoked",
                "instance.exported"
              ],
              "description": "Only events of this kind."
            },
            "required": false,
            "description": "Only events of this kind.",
            "name": "action",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of audit events.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditEventList"
                }
              }
            }
          },
          "422": {
            "description": "The request failed validation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          },
          "default": {
            "description": "Any other error, as RFC 9457 problem details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/invitations": {
      "get": {
        "tags": [
          "Invitations"
        ],
        "summary": "List open invitations",
        "description": "Admins only. Every invitation that is neither accepted nor revoked, newest first, including expired ones, which an admin resends or revokes.",
        "responses": {
          "200": {
            "description": "The open invitations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationList"
                }
              }
            }
          },
          "422": {
            "description": "The request failed validation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          },
          "default": {
            "description": "Any other error, as RFC 9457 problem details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Invitations"
        ],
        "summary": "Invite someone",
        "description": "Admins only. Creates an invitation with the role the invitee will get.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvitationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The invitation was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationWithLink"
                }
              }
            }
          },
          "409": {
            "description": "A user, or an open invitation, already has this email.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "The request failed validation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          },
          "default": {
            "description": "Any other error, as RFC 9457 problem details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/invitations/{id}/resend": {
      "post": {
        "tags": [
          "Invitations"
        ],
        "summary": "Resend an invitation",
        "description": "Admins only. Issues a new link that works for the full invitation lifetime again, and stops the old link working. Works on expired invitations too. Send `Content-Type: application/json` even though there is no body.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The invitation has a new link.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationWithLink"
                }
              }
            }
          },
          "404": {
            "description": "No open invitation has this ID.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "A user with this email exists now.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "The request failed validation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          },
          "default": {
            "description": "Any other error, as RFC 9457 problem details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/invitations/{id}/revoke": {
      "post": {
        "tags": [
          "Invitations"
        ],
        "summary": "Revoke an invitation",
        "description": "Admins only. The link stops working, and the email can be invited again. Send `Content-Type: application/json` even though there is no body.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "The invitation was revoked."
          },
          "404": {
            "description": "No open invitation has this ID.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "The request failed validation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          },
          "default": {
            "description": "Any other error, as RFC 9457 problem details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/invitations/lookup": {
      "post": {
        "tags": [
          "Invitations"
        ],
        "summary": "Check an invitation link",
        "description": "Public. Returns what the invitation is for, if the link still works. The token is sent in the body, never the URL, so it stays out of logs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvitationLookupRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The link works.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationDetails"
                }
              }
            }
          },
          "404": {
            "description": "The link is invalid, expired, revoked or already used.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "The request failed validation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          },
          "default": {
            "description": "Any other error, as RFC 9457 problem details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/invitations/accept": {
      "post": {
        "tags": [
          "Invitations"
        ],
        "summary": "Accept an invitation",
        "description": "Public. Creates the account, with the invited email and role. It does not sign in: the new user then signs in with the same email and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInvitationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The account was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptInvitationResult"
                }
              }
            }
          },
          "404": {
            "description": "The link is invalid, expired, revoked or already used.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "A user with this email already exists.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "The request failed validation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          },
          "default": {
            "description": "Any other error, as RFC 9457 problem details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
